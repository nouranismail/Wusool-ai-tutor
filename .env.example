# Server Configuration
PORT=8000
ENVIRONMENT=development

# OpenAI API Settings (for Whisper STT & LLM)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Settings (High-Speed Whisper & Llama Inference)
GROQ_API_KEY=your_groq_api_key_here

# ElevenLabs API Settings (High-Quality Expressive TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Database Settings
DATABASE_URL=sqlite:///./wusool.db
VECTOR_DB_DIR=rag_engine/knowledge_base/index